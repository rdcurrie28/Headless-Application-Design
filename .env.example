CI_SNOWFLAKE_MODE=fake
CI_POSTGRES_MODE=live
CI_S3_MODE=live

CI_API_KEYS=dev-key-change-me
CI_CORS_ORIGINS=http://localhost:3000
CI_CACHE_TTL_SECONDS=300
CI_SECTION_TIMEOUT_SECONDS=10
CI_CHURN_THRESHOLD=0.6
CI_EXPANSION_THRESHOLD=0.6

CI_SNOWFLAKE_ACCOUNT=myorg-myaccount
CI_SNOWFLAKE_USER=INSIGHTS_API
CI_SNOWFLAKE_PRIVATE_KEY_PATH=/run/secrets/snowflake_key.p8
CI_SNOWFLAKE_ROLE=INSIGHTS_API_RO
CI_SNOWFLAKE_WAREHOUSE=INSIGHTS_XS
CI_SNOWFLAKE_DATABASE=SALES
CI_SNOWFLAKE_SCHEMA=SALES_INSIGHTS

CI_POSTGRES_DSN=postgresql://insights:insights@localhost:5432/insights

CI_S3_BUCKET=customer-insights
CI_S3_REGION=us-east-1
CI_S3_ENDPOINT_URL=http://localhost:9000
CI_S3_PREFIX=customers
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
